# Database connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_exam_db

# Security & JWT Token signing
JWT_SECRET=replace_with_a_secure_random_jwt_secret_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Application Environment (development / production)
ENVIRONMENT=production
PROJECT_NAME="AI Proctored Online Examination System"

# Comma-separated list of allowed CORS origins (or * for public API)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional OpenAI API Key for GPT-4o Subjective Auto-Grading
OPENAI_API_KEY=
